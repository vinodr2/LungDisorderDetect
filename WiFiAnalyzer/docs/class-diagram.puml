@startuml WiFiAnalyzer
title WiFiAnalyzer - Phase 1 class diagram

interface IWlanClient {
  +Open()
  +Close()
  +EnumInterfaces() : TArray<TWlanIface>
  +Scan(guid)
  +GetAccessPoints(guid) : TAccessPointList
}

class TWlanClient
class TFakeWlanClient
IWlanClient <|.. TWlanClient
IWlanClient <|.. TFakeWlanClient

class TAccessPoint <<record>> {
  SSID : string
  BSSID : string
  Vendor : string
  Channel : Integer
  FrequencyMHz : Integer
  Band : TWiFiBand
  Width : TChannelWidth
  RSSI : Integer
  Quality : Integer
  Phy : TPhyType
  Auth : TAuthAlgorithm
  Cipher : TCipherAlgorithm
  Connected : Boolean
  Hidden : Boolean
}

class TScanSnapshot {
  +Items : TAccessPointList
  +Timestamp : TDateTime
  +AdapterName : string
}
TScanSnapshot o-- "many" TAccessPoint

class TAnalysisEngine {
  +Analyze(TScanSnapshot) : TChannelReport
}
class TChannelReport {
  +Stats : TChannelStatList
  +Recommended24/5/6 : Integer
  +MostCongestedChannel : Integer
}
TAnalysisEngine ..> TChannelReport : creates
TAnalysisEngine ..> TScanSnapshot : reads

class TScannerService {
  -FClient : IWlanClient
  -FThread : TScanThread
  +IntervalMs : Integer
  +OnSnapshot : event
  +OnError : event
  +Start() +Stop() +RefreshNow()
}
TScannerService --> IWlanClient
TScannerService ..> TScanSnapshot : publishes

interface IOuiVendorService {
  +LookupByBssid(bssid) : string
}
class TOuiVendorService
IOuiVendorService <|.. TOuiVendorService
TScannerService --> IOuiVendorService

class TMainViewModel {
  +UpdateFromSnapshot(TScanSnapshot)
  +VisibleCount() : Integer
  +Visible(i) : TAccessPoint
  +SortBy(col)
  +Report : TChannelReport
  +OnChanged : event
}
TMainViewModel --> TAnalysisEngine
TMainViewModel ..> TChannelReport

class TfrmMain {
  -FScanner : TScannerService
  -FVM : TMainViewModel
}
TfrmMain --> TMainViewModel
TfrmMain --> TScannerService

@enduml
